# Campground Tonight API (services/api) — runtime env. Copy to .env or export in your shell.
# Port the API listens on (default 8787).
PORT=8787

# SQLite database path (default: services/api/data/campground.db).
CAMPGROUND_DB_PATH=data/campground.db

# Enables POST /api/admin/poll (manual poll trigger) guarded by this bearer.
# Unset = the admin endpoint is disabled (503).
ADMIN_POLL_SECRET=change-me

# Poll cadence, cron syntax (spec default: every 15 minutes).
POLL_CRON=*/15 * * * *

# Identifying User-Agent for Recreation.gov requests (politeness rule).
POLL_USER_AGENT=campground-tonight/0.1 (hackathon MVP; contact: hello@masonhooten.com)

# Directory of the Expo static web export (apps/mobile/dist). Set this to serve
# the built web demo from the same process/port as the API (hosted-demo setup).
# Example: SERVE_WEB_DIST=../apps/mobile/dist
SERVE_WEB_DIST=
