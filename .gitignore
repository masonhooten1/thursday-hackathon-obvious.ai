# --- Node / Next.js (web/) ---
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# --- Models, datasets, and generated artifacts (ingestion/eval land later) ---
models/
data/
# SignalPlan's data layer is source code, not a dataset — keep it tracked
# (db.ts and encryption.ts already are). Without this negation `data/`
# silently eats every file under signalplan/lib/data/ (storage.ts was lost
# to this rule on the main branch).
!signalplan/lib/data/
*.lance/
*.pt
*.onnx
*.gguf
*.safetensors
*.ckpt
*.mlpackage
*.mlmodel
eval.json

# --- Environment & misc ---
.env*
!.env.example
.DS_Store
coverage/

# --- Campground Tonight (npm workspaces) ---
.expo/
expo-env.d.ts
dist/
*.db
*.db-shm
*.db-wal

# Reference thumbnails are generated by the ingestion pipeline
api/static/thumbs/
