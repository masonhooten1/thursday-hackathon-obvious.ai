{
  "name": "linkedin-to-email",
  "version": "0.1.0",
  "private": true,
  "description": "Hackathon monorepo: Chrome MV3 extension (root), Plant ID web app (web/ + api/), SignalPlan (signalplan/), and Campground Tonight (apps/ + services/ + packages/).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run --passWithNoTests && npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:manifest": "node scripts/check-manifest.js"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
