# Campground Tonight app (apps/mobile) — build-time env, inlined by Expo.
# Copy to .env or export in your shell before `npm start` / `npm run export:web`.

# Base URL of the Campground Tonight API. Unset = fixture mode.
#   Web demo (same origin as the API process): EXPO_PUBLIC_API_URL=/
#   Native via Expo Go (dev machine):          EXPO_PUBLIC_API_URL=http://<your-lan-ip>:8787
EXPO_PUBLIC_API_URL=

# Google Maps Platform key for the WEB bundle (Google Maps JavaScript API).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Maps Platform key for NATIVE builds — read by app.config.ts at config
# time (react-native-maps provider=google). Same key, different channel.
GOOGLE_MAPS_API_KEY=
