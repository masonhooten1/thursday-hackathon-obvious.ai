# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL and anon key (Dashboard → Settings → API). Safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Legacy JWT secret (Dashboard → Settings → API → JWT Settings). Server-only.
# Used to verify access tokens without a network round-trip.
SUPABASE_JWT_SECRET=<jwt-secret>

# Postgres connection string (Dashboard → Settings → Database → Connection
# pooling). Server-only. RLS is enforced in the database; every repository
# query additionally filters by workspace_id.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# ── Private storage (exports + page-capture snapshots) ─────────────────────
# Server-only service key; uploads go to the private bucket named by
# SUPABASE_STORAGE_BUCKET (default: exports) via the Supabase Storage REST
# API. Unconfigured (no URL or no service key) → exports/snapshots degrade
# to honest labeled states, never invented output.
# SUPABASE_URL (falls back to NEXT_PUBLIC_SUPABASE_URL above)
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_STORAGE_BUCKET=exports

# ── BYOK key encryption ─────────────────────────────────────────────────────
# 32-byte base64 key used to AES-256-GCM encrypt model keys in
# workspace_settings. Generate: openssl rand -base64 32. Server-only.
# Without it, POST /api/settings fails closed with SETTINGS_ENCRYPTION_KEY_NOT_SET.
SETTINGS_ENCRYPTION_KEY=<base64-32-bytes>

# ── Trigger.dev ─────────────────────────────────────────────────────────────
# From the Trigger.dev project setup (npx trigger.dev@latest init).
TRIGGER_PROJECT_ID=<proj_...>
TRIGGER_SECRET_KEY=<server secret for backend-triggered runs>

# ── Optional: search-based discovery (deferred) ─────────────────────────────
# SEARCH_PROVIDER_KEY=
